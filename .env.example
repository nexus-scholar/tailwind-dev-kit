# ==========================================
# Tailwind CSS Plus / Tailwind UI Credentials
# ==========================================

# Option 1: Browser Session Cookie (RECOMMENDED)
# Works with any login method (Google, GitHub, 2FA, Email)
# Open https://tailwindcss.com/plus in your browser, press F12,
# go to Application -> Cookies -> https://tailwindcss.com,
# and copy the value of `tailwind_plus_session`.
TAILWIND_SESSION=""

# Option 2: Full Cookie Header String (Alternative)
# Copy the full 'Cookie:' header from any network request in DevTools
# TAILWIND_COOKIES=""

# Option 3: Direct Email & Password Login
# If your account uses standard email/password authentication
# TAILWIND_EMAIL=""
# TAILWIND_PASSWORD=""
